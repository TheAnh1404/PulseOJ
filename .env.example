# ==============================================================================
# PulseOJ - Environment Configuration
# Copy this file to .env in the project root or configure your IDE environment
# ==============================================================================

# Neon Serverless PostgreSQL Connection String (Master Server ONLY)
# Get your connection string from https://console.neon.tech
NEON_DB_URL=jdbc:postgresql://ep-example-pooler.ap-southeast-1.aws.neon.tech/pulseoj?sslmode=require
NEON_DB_USER=pulseoj_owner
NEON_DB_PASSWORD=your_neon_db_password_here

# Network Configuration Defaults
PULSE_RMI_PORT=1099
PULSE_UDP_DISCOVERY_PORT=8888
PULSE_UDP_HEARTBEAT_PORT=8889

# Local Fallback Mode (Set true if testing without active Internet / Neon DB)
PULSE_OFFLINE_MOCK_DB=false
